# =============================================================================
# .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- PostgreSQL ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/anatomy_db

# You can also configure individual fields instead:
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=anatomy_db

# --- JWT ---
# Access token secret — use a long, random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=15m

# Refresh token secret — must be DIFFERENT from JWT_SECRET.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# (Currently unused — refresh tokens are random bytes, not JWTs — reserved for future use.)
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# --- CORS ---
# The URL of your React frontend (no trailing slash)
FRONTEND_URL=http://localhost:3000
